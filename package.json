{
  "name": "jev-arena",
  "version": "0.1.0",
  "description": "Write a fighter in plain English. A System One model (Jev) pilots it several times a second. Real-time bot battles, a PR-driven ladder, and brain swaps (Jev, Laya, kev, any LLM).",
  "author": "Eliot5566",
  "homepage": "https://eliot5566.github.io/jev-arena/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eliot5566/jev-arena.git"
  },
  "bugs": {
    "url": "https://github.com/Eliot5566/jev-arena/issues"
  },
  "type": "module",
  "bin": {
    "jev-arena": "bin/jev-arena.js"
  },
  "scripts": {
    "start": "node bin/jev-arena.js serve",
    "fight": "node bin/jev-arena.js fight",
    "ladder": "node bin/jev-arena.js ladder",
    "validate": "node bin/jev-arena.js validate",
    "build:site": "node bin/jev-arena.js build-site --out dist",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "ai-arena",
    "game",
    "bots",
    "prompt-engineering",
    "laya",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "web",
    "fighters",
    "ladder",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
